# Anthropic API key (primary backend). Get one at https://console.anthropic.com/settings/keys.
ANTHROPIC_API_KEY=

# Gemini API key (fallback backend). Get one at https://ai.google.dev/.
# Activate via HRO_BACKEND=gemini.
GEMINI_API_KEY=

# Optional knobs.
# HRO_BACKEND=anthropic|gemini   (default: anthropic)
# HRO_RPM=30                     (sliding-window rate limit per minute; default 7)
# HRO_DEVICE=cuda|mps|cpu        (embedder/reranker device; auto-detected by default)
